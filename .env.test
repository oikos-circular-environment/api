NODE_ENV=test
JWT_SECRET=test-secret

# PostgreSQL (container isolado na porta 5433)
DATABASE_URL="postgresql://oikos_test:oikos_test@localhost:5433/oikos_test"

# Storage
STORAGE_PROVIDER=minio
APP_PUBLIC_URL=http://localhost:3333

# MinIO (container isolado nas portas 9002/9003)
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=oikos_test
MINIO_SECRET_KEY=oikos_test
MINIO_BUCKET=oikos-test

# Redis (container isolado na porta 6380, sem senha)
REDIS_URL=redis://localhost:6380/0

# Quorum
QUORUM_JOB_DELAY_MS=1000

# Account deletion
ACCOUNT_DELETION_DELAY_MS=1000

# Google validation account (valores fictícios para testes)
GOOGLE_ACCOUNT_EMAIL=test@oikos.test
GOOGLE_ACCOUNT_PASSWORD=test-password

# Apple validation account (valores fictícios para testes)
APPLE_ACCOUNT_EMAIL=apple@oikos.test
APPLE_ACCOUNT_PASSWORD=test-password

# Admin (valores fictícios para testes)
ADMIN_USERNAME=test-admin
ADMIN_PASSWORD=test-password

# false: specs existentes nao enviam X-Client-Key; o comportamento de bloqueio
# (enforce=true) e coberto isoladamente em verify-client-key.spec.ts
CLIENT_KEY_ENFORCE=false
