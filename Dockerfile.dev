# ---- Stage: dev (hot-reload) ----
FROM node:lts-alpine AS dev
WORKDIR /app

COPY package*.json ./
COPY prisma/ ./prisma/
COPY prisma.config.ts ./
RUN npm install --ignore-scripts && npx prisma generate

CMD ["npm", "run", "dev"]

# ---- Stage: simulation (aproxima o comportamento de produção — build imutável, sem hot-reload) ----
# Não é a imagem real de deploy (essa vive em devops/docker/Dockerfile.api.prod) — é uma
# aproximação local pra validar comportamento antes do push, sem depender do repo devops.
FROM node:lts-alpine AS simulation-builder
WORKDIR /app

COPY package*.json ./
COPY prisma/ ./prisma/
COPY prisma.config.ts ./
RUN npm ci --ignore-scripts

COPY tsconfig.json tsconfig.build.json ./
COPY src/ ./src/
RUN npx prisma generate && npm run build

FROM node:lts-alpine AS simulation
WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./
COPY prisma/ ./prisma/
COPY prisma.config.ts ./
RUN npm ci --omit=dev --omit=optional --ignore-scripts

# prisma CLI é devDep, mas necessária pro `prisma migrate deploy` (mesmo arranjo
# do devops/docker/Dockerfile.api.prod). O client já vem gerado dentro do dist.
COPY --from=simulation-builder /app/node_modules/prisma ./node_modules/prisma
COPY --from=simulation-builder /app/node_modules/.bin/prisma ./node_modules/.bin/prisma
COPY --from=simulation-builder /app/dist ./dist

# Migration não roda no CMD (mesmo comportamento do deploy real) — rodar
# `docker compose -f docker-compose.dev.yml --profile simulation run --rm api-sim npx prisma migrate deploy`
# antes do primeiro `up`.
CMD ["npm", "start"]
