{
	"name": "api",
	"version": "1.0.0",
	"description": "",
	"license": "ISC",
	"author": "",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"dev": "concurrently \"tsx watch --env-file=.env --import ./src/lib/otel.ts src/server.ts\" \"tsc --noEmit --watch --preserveWatchOutput\"",
		"build": "tsc && tsc-alias",
		"start": "node --import ./dist/lib/otel.js dist/server.js",
		"format": "biome format --write --files-ignore-unknown=true .",
		"lint": "biome lint --write --files-ignore-unknown=true .",
		"prepare": "lefthook install",
		"postinstall": "prisma generate",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"test:infra:up": "docker compose -p oikos-test -f docker-compose.test.yml up -d --wait postgresql redis minio && docker compose -p oikos-test -f docker-compose.test.yml up createbuckets",
		"test:infra:down": "docker compose -p oikos-test -f docker-compose.test.yml down -v",
		"dev:up": "docker compose -f docker-compose.dev.yml --profile dev up",
		"dev:down": "docker compose -f docker-compose.dev.yml --profile dev down",
		"tunnel": "cloudflared tunnel run oikos-local-dev",
		"sim:migrate": "docker compose -f docker-compose.dev.yml --profile simulation run --rm api-sim npx prisma migrate deploy",
		"sim:up": "docker compose -f docker-compose.dev.yml --profile simulation up --build",
		"sim:down": "docker compose -f docker-compose.dev.yml --profile simulation down",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"migrate:dev": "prisma migrate dev",
		"migrate:generate": "prisma generate",
		"seed": "tsx prisma/seeds/index.ts",
		"cli": "tsx cli/index.ts",
		"seed:prod": "tsx scripts/seed-prod.ts",
		"client-key:create": "tsx scripts/client-key-create.ts",
		"minio:console": "xdg-open http://localhost:9001"
	},
	"prisma": {
		"seed": "tsx prisma/seeds/index.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1062.0",
		"@bull-board/api": "^8.0.0",
		"@bull-board/fastify": "^8.0.0",
		"@fastify/basic-auth": "^6.2.0",
		"@fastify/cookie": "^11.0.2",
		"@fastify/cors": "^11.2.0",
		"@fastify/jwt": "^10.0.0",
		"@fastify/multipart": "^10.0.0",
		"@fastify/otel": "^0.19.0",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/swagger": "^9.7.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.77.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
		"@opentelemetry/instrumentation-runtime-node": "^0.33.0",
		"@opentelemetry/resources": "^2.8.0",
		"@opentelemetry/sdk-metrics": "^2.8.0",
		"@opentelemetry/sdk-node": "^0.219.0",
		"@opentelemetry/semantic-conventions": "^1.41.1",
		"@prisma/adapter-pg": "^7.7.0",
		"@prisma/client": "^7.7.0",
		"@prisma/instrumentation": "^7.8.0",
		"@scalar/fastify-api-reference": "^1.52.1",
		"@supabase/supabase-js": "^2.104.0",
		"bcryptjs": "^3.0.3",
		"bullmq": "^5.77.6",
		"dotenv": "^17.4.2",
		"fastify": "^5.8.5",
		"fastify-type-provider-zod": "^6.1.0",
		"file-type": "^22.0.1",
		"ioredis": "^5.11.0",
		"pg": "^8.20.0",
		"pino": "^10.3.1",
		"pino-opentelemetry-transport": "^3.0.0",
		"sanitize-html": "^2.17.6",
		"superjson": "^2.2.6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@clack/prompts": "^1.7.0",
		"@faker-js/faker": "^10.4.0",
		"@googlemaps/google-maps-services-js": "^3.4.2",
		"@types/node": "^25.9.4",
		"@types/pg": "^8.20.0",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/coverage-v8": "^4.1.4",
		"@vitest/ui": "^4.1.4",
		"concurrently": "^10.0.3",
		"lefthook": "^1.13.6",
		"listr2": "^10.2.2",
		"pino-pretty": "^13.1.3",
		"prisma": "^7.7.0",
		"tsc-alias": "^1.8.17",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vitest": "^4.1.4"
	}
}
