// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  name            String?
  email           String    @unique
  email_verified  Boolean   @default(false)
  image           String?
  role            String    @default("user")
  banned          Boolean   @default(false)
  ban_reason      String?
  ban_expires     DateTime?
  password        String?
  auth_source     String    @default("better_auth")
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt
  deleted_at      DateTime?
  deletion_job_id String?

  profile          Profile?
  companies        Company[]
  complaints       Complaint[]
  votes            ComplaintVote[]
  resolutions      ComplaintResolution[] @relation("ResolutionResolver")
  supports         Support[]
  refresh_tokens   RefreshToken[]
  accounts         Account[]
  sessions         Session[]
  members          Member[]
  sent_invitations Invitation[]          @relation("InvitationInviter")

  reported_denunciations Denunciation[] @relation("ReporterOfDenunciations")
  target_denunciations   Denunciation[] @relation("ReportedInDenunciations")

  @@map("users")
}

model Account {
  id                       String    @id @default(uuid())
  account_id               String
  provider_id              String
  password                 String?
  access_token             String?
  refresh_token            String?
  id_token                 String?
  access_token_expires_at  DateTime?
  refresh_token_expires_at DateTime?
  scope                    String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("accounts")
}

model Session {
  id                     String   @id @default(uuid())
  token                  String   @unique
  expires_at             DateTime
  ip_address             String?
  user_agent             String?
  impersonated_by        String?
  active_organization_id String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique
  logo       String?
  created_at DateTime  @default(now())
  updated_at DateTime?

  members     Member[]
  invitations Invitation[]
  company     Company?

  @@map("organizations")
}

model Member {
  id         String   @id @default(uuid())
  role       String   @default("member")
  created_at DateTime @default(now())

  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([user_id])
  @@map("members")
}

model Invitation {
  id         String    @id @default(uuid())
  email      String
  role       String
  status     String    @default("pending")
  expires_at DateTime?
  created_at DateTime  @default(now())

  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  inviter_id String
  inviter    User   @relation("InvitationInviter", fields: [inviter_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("invitations")
}

model RefreshToken {
  id         String    @id @default(uuid())
  jti        String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}

model Profile {
  id           String   @id @default(uuid())
  full_name    String
  display_name String
  phone        String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  address_id String?  @unique
  address    Address? @relation(fields: [address_id], references: [id], onDelete: SetNull)

  profile_image    ProfileImage? @relation(fields: [profile_image_id], references: [id])
  profile_image_id String?

  @@map("profiles")
}

model ProfileImage {
  id         String    @id @default(uuid())
  url        String
  file_name  String
  path       String
  created_at DateTime  @default(now())
  profiles   Profile[]

  @@map("profile_images")
}

model Company {
  id                  String       @id @default(uuid())
  identity            String       @unique
  identity_type       IdentityType
  company_type        CompanyType
  status              Boolean      @default(true)
  business_name       String
  corporate_name      String
  email               String?
  phones              String[]
  started_activity_in DateTime
  is_company_valid    Boolean      @default(false)
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  address_id     String?               @unique
  address        Address?              @relation(fields: [address_id], references: [id], onDelete: SetNull)
  business_hours CompanyBusinessHour[]
  wastes         CompanyWaste[]
  services       CompanyService[]

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  organization_id String       @unique
  organization    Organization @relation(fields: [organization_id], references: [id])

  avatar_id String?
  avatar    CompanyAvatar? @relation(fields: [avatar_id], references: [id])

  validation  CompanyValidation?
  resolutions ComplaintResolution[]

  @@map("companies")
}

model CompanyValidation {
  id                   String  @id @default(uuid())
  general_registration Boolean @default(false)
  address              Boolean @default(false)
  business_hours       Boolean @default(false)
  wastes               Boolean @default(false)
  services             Boolean @default(false)

  company_id String  @unique
  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("company_validations")
}

model CompanyAvatar {
  id         String    @id @default(uuid())
  url        String
  file_name  String
  path       String
  created_at DateTime  @default(now())
  companies  Company[]

  @@map("company_avatars")
}

model Address {
  id         String  @id @default(uuid())
  zip_code   String
  street     String
  number     String
  complement String?
  district   String

  city_ibge_id Int
  city         String

  state_ibge_id Int
  state         String
  state_code    String

  latitude  Float
  longitude Float
  location  Unsupported("public.geography(Point, 4326)")?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profile Profile?
  company Company?

  @@map("addresses")
}

model CompanyBusinessHour {
  id          String    @id @default(uuid())
  day_of_week DayOfWeek
  is_open     Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  company_id String
  company    Company                @relation(fields: [company_id], references: [id], onDelete: Cascade)
  time_slots BusinessHourTimeSlot[]

  @@unique([company_id, day_of_week])
  @@map("company_business_hours")
}

model BusinessHourTimeSlot {
  id         String   @id @default(uuid())
  start_time String
  end_time   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business_hour_id String
  business_hour    CompanyBusinessHour @relation(fields: [business_hour_id], references: [id], onDelete: Cascade)

  @@map("business_hour_time_slots")
}

model WasteCategory {
  id            String        @id @default(uuid())
  name          String
  description   String?
  observations  String?
  hazard_levels HazardLevel[]
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  subcategories    WasteSubcategory[]
  company_wastes   CompanyWaste[]
  company_services CompanyService[]
  complaints       ComplaintWasteCategory[]

  @@map("waste_categories")
}

model WasteSubcategory {
  id           String          @id @default(uuid())
  name         String
  description  String?
  observations String?
  hazard_level HazardLevel
  type         SubcategoryType @default(INCLUDE)
  created_at   DateTime        @default(now())

  category_id String
  category    WasteCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@map("waste_subcategories")
}

model CompanyWaste {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  unit        Measurement
  quantity    Decimal     @db.Decimal(12, 2)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  waste_category_id String
  waste_category    WasteCategory @relation(fields: [waste_category_id], references: [id], onDelete: Restrict)

  @@map("company_wastes")
}

model CompanyService {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  unit        Measurement
  quantity    Decimal     @db.Decimal(12, 2)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  waste_category_id String
  waste_category    WasteCategory @relation(fields: [waste_category_id], references: [id], onDelete: Restrict)

  @@map("company_services")
}

model Complaint {
  id           String                                        @id @default(uuid())
  status       ComplaintStatus                               @default(OPEN)
  date         DateTime
  observations String?
  geospatial   Json
  location     Unsupported("public.geography(Point, 4326)")?
  created_at   DateTime                                      @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  attachments      ComplaintAttachment[]
  votes            ComplaintVote[]
  resolutions      ComplaintResolution[]
  waste_categories ComplaintWasteCategory[]

  @@index([user_id, created_at(sort: Desc)])
  @@map("complaints")
}

model ComplaintWasteCategory {
  complaint_id      String
  waste_category_id String

  complaint      Complaint     @relation(fields: [complaint_id], references: [id], onDelete: Cascade)
  waste_category WasteCategory @relation(fields: [waste_category_id], references: [id], onDelete: Restrict)

  @@id([complaint_id, waste_category_id])
  @@map("complaint_waste_categories")
}

enum ComplaintCaptureMode {
  PHOTO
  VIDEO
}

model ComplaintAttachment {
  id         String   @id @default(uuid())
  url        String
  file_name  String
  path       String
  base64     String
  metadata   Json?
  created_at DateTime @default(now())

  type ComplaintCaptureMode @default(PHOTO)

  complaint_id String
  complaint    Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)

  @@map("complaint_attachments")
}

model Support {
  id             String              @id @default(uuid())
  title          String
  description    String
  type           SupportType         @default(SUPPORT)
  status         ModerationStatus    @default(OPEN)
  severity       ModerationSeverity?
  environment    Json?
  reporter_email String?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)

  attachments SupportAttachment[]

  @@map("supports")
}

model SupportAttachment {
  id         String   @id @default(uuid())
  url        String
  file_name  String
  path       String
  created_at DateTime @default(now())

  support_id String
  support    Support @relation(fields: [support_id], references: [id], onDelete: Cascade)

  @@map("support_attachments")
}

model Denunciation {
  id             String              @id @default(uuid())
  title          String
  description    String
  status         ModerationStatus    @default(OPEN)
  severity       ModerationSeverity?
  reporter_email String?
  latitude       Float?
  longitude      Float?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt

  reporter_user_id String?
  reporter         User?   @relation("ReporterOfDenunciations", fields: [reporter_user_id], references: [id], onDelete: SetNull)

  reported_user_id String?
  reported_user    User?   @relation("ReportedInDenunciations", fields: [reported_user_id], references: [id], onDelete: SetNull)

  attachments DenunciationAttachment[]

  @@map("denunciations")
}

model DenunciationAttachment {
  id         String               @id @default(uuid())
  url        String
  file_name  String
  path       String
  base64     String
  metadata   Json?
  type       ComplaintCaptureMode @default(PHOTO)
  created_at DateTime             @default(now())

  denunciation_id String
  denunciation    Denunciation @relation(fields: [denunciation_id], references: [id], onDelete: Cascade)

  @@map("denunciation_attachments")
}

model ComplaintVote {
  id         String            @id @default(uuid())
  vote_type  ComplaintVoteType
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  complaint_id String
  complaint    Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([complaint_id, user_id])
  @@map("complaint_votes")
}

model ComplaintResolution {
  id          String   @id @default(uuid())
  description String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  complaint_id String
  complaint    Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)

  resolver_user_id String
  resolver_user    User   @relation("ResolutionResolver", fields: [resolver_user_id], references: [id], onDelete: Cascade)

  company_id String?
  company    Company? @relation(fields: [company_id], references: [id], onDelete: SetNull)

  attachments ComplaintResolutionAttachment[]

  @@unique([complaint_id, resolver_user_id, company_id])
  @@map("complaint_resolutions")
}

model ComplaintResolutionAttachment {
  id         String   @id @default(uuid())
  url        String
  file_name  String
  path       String
  base64     String
  created_at DateTime @default(now())

  type          ComplaintCaptureMode @default(PHOTO)
  resolution_id String
  resolution    ComplaintResolution  @relation(fields: [resolution_id], references: [id], onDelete: Cascade)

  @@map("complaint_resolution_attachments")
}
