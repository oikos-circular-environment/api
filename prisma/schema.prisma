// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  profile    Profile?

  companies  Company[]
  complaints Complaint[]
  votes      ComplaintVote[]
  resolutions ComplaintResolution[] @relation("ResolutionResolver")

  @@map("users")
}

model Profile {
  id           String   @id @default(uuid())
  full_name    String
  display_name String
  cpf          String   @unique
  phone        String
  is_collector Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  address_id String?  @unique
  address    Address? @relation(fields: [address_id], references: [id], onDelete: SetNull)

  profile_image    ProfileImage? @relation(fields: [profile_image_id], references: [id])
  profile_image_id String?

  @@map("profiles")
}

model ProfileImage {
  id         String    @id @default(uuid())
  url        String
  file_name  String
  path       String
  created_at DateTime  @default(now())
  profiles   Profile[]

  @@map("profile_images")
}

model Company {
  id                  String       @id @default(uuid())
  identity            String       @unique
  identity_type       IdentityType
  company_type        CompanyType
  status              Boolean      @default(true)
  is_headquarters     Boolean      @default(false)
  business_name       String?
  corporate_name      String
  accept_appointments Boolean      @default(false)
  email               String?
  phones              String[]
  started_activity_in DateTime
  description         String?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  address_id     String?               @unique
  address        Address?              @relation(fields: [address_id], references: [id], onDelete: SetNull)
  business_hours CompanyBusinessHour[]
  wastes         CompanyWaste[]
  services       CompanyService[]

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  avatar_id String?
  avatar    CompanyAvatar? @relation(fields: [avatar_id], references: [id])

  resolutions ComplaintResolution[]

  @@map("companies")
}

model CompanyAvatar {
  id         String    @id @default(uuid())
  url        String
  file_name  String
  path       String
  created_at DateTime  @default(now())
  companies  Company[]

  @@map("company_avatars")
}

model Address {
  id         String  @id @default(uuid())
  zip_code   String
  street     String
  number     String
  complement String?
  district   String

  city_ibge_id Int
  city         String

  state_ibge_id Int
  state         String
  state_code    String

  latitude  Float?
  longitude Float?
  location  Unsupported("geography(Point, 4326)")?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profile Profile?
  company Company?

  @@map("addresses")
}

model CompanyBusinessHour {
  id          String    @id @default(uuid())
  day_of_week DayOfWeek
  is_open     Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  company_id String
  company    Company                @relation(fields: [company_id], references: [id], onDelete: Cascade)
  time_slots BusinessHourTimeSlot[]

  @@unique([company_id, day_of_week])
  @@map("company_business_hours")
}

model BusinessHourTimeSlot {
  id         String   @id @default(uuid())
  start_time String
  end_time   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business_hour_id String
  business_hour    CompanyBusinessHour @relation(fields: [business_hour_id], references: [id], onDelete: Cascade)

  @@map("business_hour_time_slots")
}

model CompanyWaste {
  id           String      @id @default(uuid())
  name         String
  description  String?
  price        Decimal     @db.Decimal(12, 2)
  unit         Measurement
  waste_type   WasteType
  quantity     Decimal     @db.Decimal(12, 2)
  observations String?
  sub_items    String[]
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("company_wastes")
}

model CompanyService {
  id           String      @id @default(uuid())
  name         String
  description  String?
  price        Decimal     @db.Decimal(12, 2)
  unit         Measurement
  waste_type   WasteType
  quantity     Decimal     @db.Decimal(12, 2)
  observations String?
  sub_items    String[]
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("company_services")
}

model Complaint {
  id               String          @id @default(uuid())
  status           ComplaintStatus @default(OPEN)
  type             ComplaintType
  complaint_method ComplaintMethod
  observations     String?
  location         Unsupported("geography(Point, 4326)")?
  created_at       DateTime        @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  captures    ComplaintCapture[]
  votes       ComplaintVote[]
  resolutions ComplaintResolution[]

  @@map("complaints")
}

model ComplaintCapture {
  id           String   @id @default(uuid())
  date         DateTime
  observations String?
  geospatial   Json
  created_at   DateTime @default(now())

  complaint_id String
  complaint    Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)

  attachments ComplaintAttachment[]

  @@map("complaint_captures")
}

enum ComplaintCaptureMode {
  PHOTO
  VIDEO
}

model ComplaintAttachment {
  id         String   @id @default(uuid())
  url        String
  file_name  String
  path       String
  base64     String
  metadata   Json?
  created_at DateTime @default(now())

  type       ComplaintCaptureMode @default(PHOTO)

  capture_id String
  capture    ComplaintCapture @relation(fields: [capture_id], references: [id], onDelete: Cascade)

  @@map("complaint_attachments")
}

model ComplaintVote {
  id         String            @id @default(uuid())
  vote_type  ComplaintVoteType
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  complaint_id String
  complaint    Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([complaint_id, user_id])
  @@map("complaint_votes")
}

model ComplaintResolution {
  id          String   @id @default(uuid())
  description String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  complaint_id String
  complaint    Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)

  resolver_user_id String
  resolver_user    User   @relation("ResolutionResolver", fields: [resolver_user_id], references: [id], onDelete: Cascade)

  company_id String?
  company    Company? @relation(fields: [company_id], references: [id], onDelete: SetNull)

  attachments ComplaintResolutionAttachment[]

  @@unique([complaint_id, resolver_user_id])
  @@map("complaint_resolutions")
}

model ComplaintResolutionAttachment {
  id         String   @id @default(uuid())
  url        String
  file_name  String
  path       String
  base64     String
  created_at DateTime @default(now())

  type          ComplaintCaptureMode @default(PHOTO)
  resolution_id String
  resolution    ComplaintResolution @relation(fields: [resolution_id], references: [id], onDelete: Cascade)

  @@map("complaint_resolution_attachments")
}
