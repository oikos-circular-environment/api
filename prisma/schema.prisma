// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdentityType {
  CPF
  CNPJ
}

enum CompanyType {
  ONG
  COMPANY
  GOVERNMENT
  COLLECTOR
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum Measurement {
  KG
  L
  UNIT
  M
  M2
  M3
  ML
}

enum WasteType {
  RECYCLABLE
  GARBAGE
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  profile    Profile?

  company        Company?
  userComplaints UserComplaint[]

  @@map("users")
}

model Profile {
  id           String   @id @default(uuid())
  full_name    String
  display_name String
  cpf          String   @unique
  phone        String
  email        String   @unique
  is_collector Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  address_id String?  @unique
  address    Address? @relation(fields: [address_id], references: [id], onDelete: SetNull)

  profile_image    ProfileImage? @relation(fields: [profile_image_id], references: [id])
  profile_image_id String?

  @@map("profiles")
}

model ProfileImage {
  id         String    @id @default(uuid())
  url        String
  file_name  String
  path       String
  base64     String
  created_at DateTime  @default(now())
  profiles   Profile[]

  @@map("profile_images")
}

model Company {
  id                  String       @id @default(uuid())
  identity            String       @unique
  identity_type       IdentityType
  company_type        CompanyType
  status              Boolean      @default(true)
  is_headquarters     Boolean      @default(false)
  business_name       String?
  corporate_name      String
  accept_appointments Boolean      @default(false)
  email               String?
  phones              String[]
  started_activity_in DateTime
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  address_id     String?               @unique
  address        Address?              @relation(fields: [address_id], references: [id], onDelete: SetNull)
  business_hours CompanyBusinessHour[]
  wastes         CompanyWaste[]
  services       CompanyService[]
  user_id        String                @unique
  user           User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("companies")
}

model Address {
  id         String   @id @default(uuid())
  zip_code   String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  state_code String
  latitude   Float?
  longitude  Float?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profile Profile?
  company Company?

  @@map("addresses")
}

model CompanyBusinessHour {
  id          String    @id @default(uuid())
  day_of_week DayOfWeek
  is_open     Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  company_id String
  company    Company                @relation(fields: [company_id], references: [id], onDelete: Cascade)
  time_slots BusinessHourTimeSlot[]

  @@unique([company_id, day_of_week])
  @@map("company_business_hours")
}

model BusinessHourTimeSlot {
  id         String   @id @default(uuid())
  start_time String
  end_time   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business_hour_id String
  business_hour    CompanyBusinessHour @relation(fields: [business_hour_id], references: [id], onDelete: Cascade)

  @@map("business_hour_time_slots")
}

model CompanyWaste {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  unit        Measurement
  waste_type  WasteType
  sub_items   String[]
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("company_wastes")
}

model CompanyService {
  id           String      @id @default(uuid())
  name         String
  description  String?
  price        Decimal     @db.Decimal(12, 2)
  unit         Measurement
  waste_type   WasteType
  quantity     Int
  observations String?
  sub_items    String[]
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("company_services")
}

enum ComplaintType {
  IRREGULAR_DISPOSAL
  DEFORESTATION
  BURNING
  VACANT_LOT
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
  CANCELED
}

model UserComplaint {
  id     String          @id @default(uuid())
  status ComplaintStatus @default(OPEN)
  // complaint_captures ComplaintCapture[] @relation("ComplaintCaptures")

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  complaint    Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)
  complaint_id String

  created_at DateTime @default(now())

  @@map("user_complaints")
}

model Complaint {
  id           String        @id @default(uuid())
  date         DateTime
  type         ComplaintType
  observations String?

  /// Expected payload shape stored as raw JSON from expo-location.
  /// The application should validate this structure before persisting it.
  geospatial Json

  userComplaints UserComplaint[]

  attachment    ComplaintAttachment? @relation(fields: [attachment_id], references: [id])
  attachment_id String?

  @@map("complaints")
}

enum ComplaintCaptureMode {
  PHOTO
  VIDEO
}

model ComplaintAttachment {
  id         String   @id @default(uuid())
  url        String
  file_name  String
  path       String
  base64     String
  created_at DateTime @default(now())

  type       ComplaintCaptureMode @default(PHOTO)
  complaints Complaint[]

  @@map("complaint_attachments")
}
