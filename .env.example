NODE_ENV=dev
JWT_SECRET=supersecret

# Prisma
# Local (docker-compose): postgresql://oikos:oikos_dev@localhost:5432/oikos
# Production: substitua pela connection string do Supabase
DATABASE_URL="postgresql://oikos:oikos_dev@localhost:5432/oikos"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_OIKOS_PROFILES_BUCKET="oikos"

# GitHub
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Google Places API
GOOGLE_PLACES_API_KEY=""

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379
