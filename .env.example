NODE_ENV=dev
JWT_SECRET=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Prisma
# Fora do docker: postgresql://USER:PASS@localhost:5432/DB
# Dentro do docker: docker-compose.yml monta a URL automaticamente
DATABASE_URL=

# Storage
# minio | supabase
STORAGE_PROVIDER=minio
APP_PUBLIC_URL=http://localhost:3333
# URL of the web frontend. Used to build links sent by email (e.g. verify-email).
WEB_APP_URL=http://localhost:3000

# MinIO (obrigatório quando STORAGE_PROVIDER=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=oikos

# Supabase (obrigatório apenas quando STORAGE_PROVIDER=supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_OIKOS_PROFILES_BUCKET="oikos"

# GitHub
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Google Places API
GOOGLE_PLACES_API_KEY=""

# Redis (BullMQ)
REDIS_PASSWORD=
# Fora do docker: redis://:PASS@localhost:6379
# Dentro do docker: docker-compose.yml monta a URL automaticamente
REDIS_URL=

# Quorum job delay (em ms). Padrão produção: 86400000 (24h). Use valores menores em dev/test.
QUORUM_JOB_DELAY_MS=86400000

# Account deletion delay (em ms). Padrão produção: 7776000000 (90 dias). Use valores menores em dev/test.
ACCOUNT_DELETION_DELAY_MS=7776000000

# Google validation account (seed)
GOOGLE_ACCOUNT_EMAIL="google@oikos.company"
GOOGLE_ACCOUNT_PASSWORD="!Google2468*"

# Apple validation account (seed)
APPLE_ACCOUNT_EMAIL="apple@oikos.company"
APPLE_ACCOUNT_PASSWORD="!Apple2468*"

# Admin credentials (basic auth for /docs, /bullboard)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Autenticacao de cliente (mobile/web) via header X-Client-Key
CLIENT_KEY_MOBILE=
CLIENT_KEY_WEB=
CLIENT_KEY_ENFORCE=true

# Allowlist de origens de browser para CORS, separadas por virgula. Em dev/test localhost, local-oikos e local-api ja sao aceitos. Vazio em producao mantem origin: "*"
CORS_ALLOWED_ORIGINS=

# Better Auth
BETTER_AUTH_SECRET= # obrigatorio (min 32 chars: openssl rand -base64 32)
# BETTER_AUTH_URL= # default: APP_PUBLIC_URL
# BETTER_AUTH_TRUSTED_ORIGINS= # origens confiaveis para CSRF, separadas por virgula (default: baseURL)
EMAIL_PROVIDER=console # console | in-memory | resend

# Exige verificacao de e-mail antes de permitir login com e-mail/senha.
# Aplica-se apenas ao fluxo e-mail/senha; login social nao e afetado.
# Padrao: false.
# REQUIRE_EMAIL_VERIFICATION=true

# Resend (obrigatorio quando EMAIL_PROVIDER=resend)
# O dominio do remetente precisa estar verificado no Resend — hoje so
# mail.oikos.company (regiao sa-east-1). Endereco fora dele retorna 422.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Oikos <noreply@mail.oikos.company>

# OpenTelemetry — activa observabilidade local (ver devops/README.md)
# Requer a stack de observabilidade rodando: devops/observability/
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otelcol:4318
