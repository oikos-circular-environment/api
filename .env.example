NODE_ENV=dev
JWT_SECRET=supersecret

# Prisma
# Fora do docker: postgresql://oikos:oikos_dev@localhost:5432/oikos
# Dentro do docker (via docker-compose override): postgresql://oikos:oikos_dev@postgresql:5432/oikos
DATABASE_URL="postgresql://oikos:oikos_dev@localhost:5432/oikos"

# Storage
# minio | supabase
STORAGE_PROVIDER=minio
APP_PUBLIC_URL=http://localhost:3333

# MinIO (obrigatório quando STORAGE_PROVIDER=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=oikos
MINIO_SECRET_KEY=oikos_dev
MINIO_BUCKET=oikos

# Supabase (obrigatório apenas quando STORAGE_PROVIDER=supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_OIKOS_PROFILES_BUCKET="oikos"

# GitHub
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Google Places API
GOOGLE_PLACES_API_KEY=""

# Redis (BullMQ)
# Fora do docker: redis://localhost:6379
# Dentro do docker (via docker-compose override): redis://redis:6379
REDIS_URL=redis://localhost:6379

# Quorum job delay (em ms). Padrão produção: 86400000 (24h). Use valores menores em dev/test.
QUORUM_JOB_DELAY_MS=86400000

# Google validation account (seed)
GOOGLE_ACCOUNT_EMAIL="google@oikos.company"
GOOGLE_ACCOUNT_PASSWORD="!Google2468*"
