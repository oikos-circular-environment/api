NODE_ENV=production
JWT_SECRET=

# PostgreSQL — usados pelo docker-compose.prod.yml para montar DATABASE_URL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=oikos

# DATABASE_URL — dentro do Docker é montado automaticamente pelo compose
# Para conexão direta (migrations manuais fora do container):
# DATABASE_URL=postgresql://USER:PASS@localhost:5432/DB
DATABASE_URL=

# Storage — produção geralmente usa Supabase; minio é opção self-hosted
# minio | supabase
STORAGE_PROVIDER=minio
# URL pública da API (usada em links de arquivos, e-mails, etc.)
APP_PUBLIC_URL=https://api.seu-dominio.com

# MinIO (obrigatório quando STORAGE_PROVIDER=minio)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=oikos

# Supabase (obrigatório quando STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_OIKOS_PROFILES_BUCKET=oikos

# Redis — dentro do Docker é montado automaticamente pelo compose
REDIS_PASSWORD=
REDIS_URL=

# Delays de produção (valores menores em dev para facilitar testes)
QUORUM_JOB_DELAY_MS=86400000
ACCOUNT_DELETION_DELAY_MS=7776000000
WORKER_CONCURRENCY=5

# Google validation account
GOOGLE_ACCOUNT_EMAIL=
GOOGLE_ACCOUNT_PASSWORD=

# Admin credentials (basic auth para /docs e /bullboard)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Logs ────────────────────────────────────────────────────────────────────
# Nível de log da aplicação. Produção: info. Debug temporário: debug.
LOG_LEVEL=info
# Capturar queries SQL brutas em logs/queries.log.
# Com OTel ativo, duração e operações já chegam via PrismaInstrumentation — manter false.
# Habilitar apenas temporariamente para inspecionar SQL gerado e parâmetros reais.
PRISMA_QUERY_LOG=false

# ── Observabilidade (OpenTelemetry + Grafana stack) ──────────────────────────
# Endereço do OTel Collector no servidor de observabilidade.
# Quando definido, activa traces e métricas no Grafana. Deixar vazio para desabilitar (zero overhead).
OTEL_EXPORTER_OTLP_ENDPOINT=http://<IP-DO-SERVIDOR-OBS>:4318

# Endereço do Loki no servidor de observabilidade (usado pelo promtail).
# Necessário apenas ao iniciar com: docker compose --profile obs up
LOKI_URL=http://<IP-DO-SERVIDOR-OBS>:3100
