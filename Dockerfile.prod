# ---- Stage 1: Builder ----
FROM node:22-alpine AS builder
WORKDIR /app

# O lockfile foi gerado com npm v11; garantir versão consistente no container
RUN npm install -g npm@11

COPY package*.json ./
COPY prisma/ ./prisma/
COPY prisma.config.ts ./
RUN npm ci --ignore-scripts

COPY tsconfig.json ./
COPY src/ ./src/
RUN npx prisma generate && npm run build

# ---- Stage 2: Production ----
FROM node:22-alpine AS production
WORKDIR /app

ENV NODE_ENV=production

RUN npm install -g npm@11

COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts

# prisma CLI é devDep, mas necessária para rodar migrations no startup
COPY --from=builder /app/node_modules/prisma ./node_modules/prisma
COPY --from=builder /app/node_modules/.bin/prisma ./node_modules/.bin/prisma

# Aplicação compilada (inclui dist/seeds/ para execução manual via docker exec)
COPY --from=builder /app/dist ./dist

# Schema, migrations e config do Prisma para migrate deploy em runtime
COPY --from=builder /app/prisma/schema.prisma ./prisma/schema.prisma
COPY --from=builder /app/prisma/enums.prisma ./prisma/enums.prisma
COPY --from=builder /app/prisma/migrations ./prisma/migrations
COPY prisma.config.ts ./

# JSON de dados para seeds (necessário se rodar: docker exec <container> node dist/seeds/index.js)
COPY prisma/seeds/recycling-companies.json ./prisma/seeds/recycling-companies.json

# Diretório de logs (montado como volume no compose)
RUN mkdir -p logs

EXPOSE 3333

CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && node dist/server.js"]
