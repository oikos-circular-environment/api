{
	"name": "@oikos-circular-environment/oikos-sdk",
	"version": "0.1.0",
	"description": "SDK tipado da API Oikos, gerado com @hey-api/openapi-ts.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"default": "./dist/client/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oikos-circular-environment/api.git",
		"directory": "packages/oikos-sdk"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"scripts": {
		"generate": "openapi-ts",
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"check-types": "tsc --noEmit"
	},
	"keywords": [
		"oikos",
		"sdk",
		"openapi"
	],
	"license": "PolyForm-Noncommercial-1.0.0",
	"dependencies": {
		"axios": "^1.19.0"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "^0.97.1",
		"@types/node": "^24.13.3",
		"typescript": "^6.0.2"
	}
}
